+    def _settle_host_tool_registration(
+        self, registration: _HostToolRegistration, *, rejected: bool
+    ) -> None:
+        """Settle a registration while holding _state_lock; never wait for I/O."""
+        if registration.settled:
+            return
+        registration.settled = True
+        if not rejected:
+            # Accepted or uncertain outcomes anchor subsequent replacements.
+            # Retain predecessors only while an outcome is still pending.
+            registration.previous = None
+            return
+        registration.rejected = True
+        current = self._host_tool_registration
+        while current.rejected and current.previous is not None:
+            current = current.previous
+        self._host_tool_registration = current
+        self._custom_tools = current.tools
 
