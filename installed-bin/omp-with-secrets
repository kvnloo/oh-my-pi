#!/usr/bin/env bash
# Load BWS bootstrap + bulk secrets, then exec omp (or args).
set -euo pipefail
INJECT="${OMP_BWS_INJECT:-$HOME/.omp/bin/omp-bws-inject.sh}"
if [[ -x "$INJECT" ]]; then
  # shellcheck disable=SC1090
  eval "$("$INJECT")" || true
fi
if [[ $# -eq 0 ]]; then
  exec omp
fi
exec "$@"
