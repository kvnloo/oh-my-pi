#!/usr/bin/env python3
"""Minimal OMP RPC server for Handsfree HUD E2E.

Real `omp-handsfree-omp` boots the coding agent and can stall on session I/O.
Isolation smoke only needs a ready RPC peer that answers host-tool and prompt
handshakes without touching disk-heavy agent state.
"""

from __future__ import annotations

import json
import sys


def respond(request_id, command, data=None, success=True, error=None):
    payload = {
        "id": request_id,
        "type": "response",
        "command": command,
        "success": success,
    }
    if success and data is not None:
        payload["data"] = data
    if not success:
        payload["error"] = error or "error"
    print(json.dumps(payload), flush=True)


def state():
    return {
        "model": {
            "id": "e2e-stub",
            "name": "E2E Stub",
            "api": "anthropic-messages",
            "provider": "stub",
            "baseUrl": "https://example.invalid",
            "reasoning": False,
            "input": ["text"],
            "cost": {
                "input": 0.0,
                "output": 0.0,
                "cacheRead": 0.0,
                "cacheWrite": 0.0,
            },
            "contextWindow": 1000,
            "maxTokens": 256,
        },
        "thinkingLevel": "off",
        "isStreaming": False,
        "isCompacting": False,
        "steeringMode": "one-at-a-time",
        "followUpMode": "one-at-a-time",
        "interruptMode": "immediate",
        "sessionId": "e2e-session",
        "sessionName": "Handsfree E2E",
        "fastModeEnabled": False,
        "fastModeActive": False,
        "tokensPerSecond": 0.0,
        "autoCompactionEnabled": False,
        "messageCount": 0,
        "queuedMessageCount": 0,
        "todoPhases": [],
        "dumpTools": [],
    }


def voice_idle(mode: str = "live"):
    return {"mode": mode, "phase": "idle"}


print(json.dumps({"type": "ready"}), flush=True)

for raw in sys.stdin:
    line = raw.strip()
    if not line:
        continue
    try:
        command = json.loads(line)
    except json.JSONDecodeError:
        continue
    command_type = command.get("type")
    request_id = command.get("id")
    if command_type is None or request_id is None:
        continue

    if command_type == "get_state":
        respond(request_id, command_type, state())
    elif command_type == "set_host_tools":
        tools = command.get("tools") or []
        names = [tool.get("name", "") for tool in tools if isinstance(tool, dict)]
        respond(request_id, command_type, {"toolNames": names})
    elif command_type in {"prompt", "abort_and_prompt", "steer", "follow_up", "abort"}:
        # Never schedule a real agent turn; HUD only needs a ready peer.
        respond(request_id, command_type, {"agentInvoked": False})
    elif command_type in {
        "dictation_start",
        "dictation_stop",
        "dictation_cancel",
        "live_start",
        "live_stop",
        "live_toggle_mute",
    }:
        mode = "dictation" if command_type.startswith("dictation") else "live"
        respond(request_id, command_type, voice_idle(mode))
    elif command_type == "get_messages":
        respond(request_id, command_type, {"messages": []})
    else:
        respond(request_id, command_type, {})
